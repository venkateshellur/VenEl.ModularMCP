<Project>
  <PropertyGroup>
    <PackageReadmeFile>MODULE_README.md</PackageReadmeFile>
    <Description>A dynamically-loaded plugin module for VenEl.ModularMCP. This is not intended to be used as a standalone package.</Description>
    <Authors>Venkatesh Ellur</Authors>
    <Company>VenEl</Company>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)MODULE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
